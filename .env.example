# Copy to .env.local and fill in what you have. Everything is optional —
# without keys the site runs in local demo mode (file store, outbox email,
# demo payments), and each service switches on independently when its key is set.

# --- Site ---
# Public URL used in emails and Stripe redirects (no trailing slash).
SITE_URL=http://localhost:3000

# --- Admin ---
# Password for /admin. REQUIRED before launch (dev default: cleanout-admin).
ADMIN_PASSWORD=
# Random string used to sign session cookies and accept-quote links.
# Generate one with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Database + photo storage (Supabase) ---
# Create a project at supabase.com, run supabase/schema.sql in the SQL editor,
# then paste these from Project Settings -> API. Photos need a public storage
# bucket named "job-photos".
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend) ---
# Create a key at resend.com. Until a domain is verified, Resend only delivers
# to your own account email — fine for testing.
RESEND_API_KEY=
# Sender shown to customers, e.g. "LI Cleanout <quotes@yourdomain.com>"
EMAIL_FROM=
# Where "new lead" notifications go (defaults to the site email).
OWNER_EMAIL=

# --- Payments (Stripe) ---
# Secret key from dashboard.stripe.com (use the sk_test_... key first).
STRIPE_SECRET_KEY=
# Webhook signing secret for the /api/stripe/webhook endpoint (whsec_...).
STRIPE_WEBHOOK_SECRET=
